{
  "expo": {
    "name": "PetFeed",
    "slug": "PetFeed",
    "version": "1.5.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petfeed",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#34C759"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joewilson.PetFeed",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "This app needs access to your local network to find and control PetFeed devices on your Wi-Fi.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSUserNotificationUsageDescription": "PetFeed uses notifications to remind you when a feed is scheduled."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.joewilson.PetFeed"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-ble-plx"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54e2527e-f42b-4dfc-9218-933453609eb2"
      }
    }
  }
}
